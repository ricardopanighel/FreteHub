# Variaveis de ambiente da API (backend/). Copie para .env (ignorado pelo git)
# ou exporte no shell antes de subir a aplicacao.

# Perfil ativo: dev (padrao) ou prod.
SPRING_PROFILES_ACTIVE=dev

# Porta da API (padrao 8080). Se mudar, aponte o proxy do front com
# VITE_PROXY_TARGET=http://localhost:<porta> ao rodar `npm run dev`.
SERVER_PORT=8080

# Banco de dados PostgreSQL.
DB_URL=jdbc:postgresql://localhost:5432/fretehub
DB_USER=fretehub
DB_PASSWORD=fretehub

# Enderecos do front que podem chamar a API, separados por virgula.
# Padrao: o Vite local (http://localhost:5173 e http://127.0.0.1:5173).
# CORS_ALLOWED_ORIGINS=https://fretehub-web.onrender.com

# Segredo do JWT (HMAC-SHA256). Obrigatorio em prod, com 32+ caracteres.
# Em dev, se vazio, uma chave efemera e gerada a cada subida.
JWT_SECRET=
JWT_EXPIRATION_HOURS=12
